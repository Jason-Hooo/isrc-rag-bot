# 請複製並修改此檔案為 .env


# Google Cloud Service Account 金鑰 JSON 檔案路徑
# 下載 Google Cloud Service Account 的 JSON 金鑰檔案，並填入檔案路徑
GOOGLE_APPLICATION_CREDENTIALS=./keys/google-credentials.json


# 填入GCP 專案的唯一識別碼（Project ID），非專案名稱
GOOGLE_CLOUD_PROJECT=your-project-id


# 運行 Gemini 模型的 Google 資料中心區域。
GOOGLE_CLOUD_LOCATION=us-central1


# 對話紀錄的 sheet 名稱
GOOGLE_SHEET_NAME=原資智慧服務 AI 機器人回覆蒐集表


# 填入 JINAAI_API_KEY（Jina AI 產生的 key，用於 Embedding 與 Reranker）
JINAAI_API_KEY=


# Qdrant Cloud 連線設定
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key



